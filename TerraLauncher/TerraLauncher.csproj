<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- NU1903: Tmds.DBus.Protocol 0.20.0 vulnerability is in Linux-only D-Bus code,
         unreachable on macOS/Windows. Fixed in Avalonia 12.x (upgrades to 0.92.0).
         AVLN3001: windows/controls with parameterized constructors are constructed
         from code, never via the runtime XAML loader — the warning doesn't apply. -->
    <NoWarn>$(NoWarn);NU1903;AVLN3001</NoWarn>
    <AssemblyName>TerraLauncher</AssemblyName>
    <RootNamespace>TerraLauncher</RootNamespace>
    <AssemblyTitle>Terra Launcher</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Trigger's Tools &amp; Games</Company>
    <Copyright>Copyright © Robert Jordan 2017</Copyright>
  </PropertyGroup>
  <!-- Windows-only settings -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- All images, fonts, and other assets accessible via avares://TerraLauncher/... -->
    <AvaloniaResource Include="Resources\**\*" Exclude="Resources\Terraria\Sounds\*.wav" />
    <!-- Platform bundle/packaging files are build-time artifacts, not runtime Avalonia assets -->
    <None Include="macOS\**\*" />
    <None Include="linux\**\*" />
    <AvaloniaResource Include="App.ico" />
    <!-- Sounds embedded so they can be loaded into a MemoryStream for SoundPlayer -->
    <EmbeddedResource Include="Resources\Terraria\Sounds\MenuClose.wav" />
    <EmbeddedResource Include="Resources\Terraria\Sounds\MenuOpen.wav" />
    <EmbeddedResource Include="Resources\Terraria\Sounds\MenuTick.wav" />
    <!-- Version data JSONs for instance manager -->
    <EmbeddedResource Include="Resources\VersionData\terraria-versions.json" />
    <EmbeddedResource Include="Resources\VersionData\tapi.json" />
    <EmbeddedResource Include="Resources\VersionData\tconfig.json" />
    <EmbeddedResource Include="Resources\VersionData\standalone.json" />
  </ItemGroup>
  <!-- Exclude old WPF files and Windows-only IconPack from compilation -->
  <ItemGroup>
    <Compile Remove="IconPack\**\*.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Properties\Resources.Designer.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="Windows\FolderBrowserLauncher.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <None Remove="Properties\Settings.settings" />
  </ItemGroup>
  <!-- Exclude old XAML code-behind files -->
  <ItemGroup>
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="Controls\IntSpinner.xaml.cs" />
    <Compile Remove="Controls\SetupTreeView.xaml.cs" />
    <Compile Remove="Controls\Terraria\TerrariaSetupEntry.xaml.cs" />
    <Compile Remove="Controls\Terraria\TerrariaSetupFolder.xaml.cs" />
    <Compile Remove="Controls\Terraria\TerrariaSetupList.xaml.cs" />
    <Compile Remove="Controls\Terraria\TerrariaSetupOptionButton.xaml.cs" />
    <Compile Remove="Controls\Terraria\TerrariaTooltip.xaml.cs" />
    <Compile Remove="Windows\AboutWindow.xaml.cs" />
    <Compile Remove="Windows\CreditsWindow.xaml.cs" />
    <Compile Remove="Windows\EditFolderWindow.xaml.cs" />
    <Compile Remove="Windows\EditGameWindow.xaml.cs" />
    <Compile Remove="Windows\EditServerWindow.xaml.cs" />
    <Compile Remove="Windows\EditToolWindow.xaml.cs" />
    <Compile Remove="Windows\ErrorMessageBox.xaml.cs" />
    <Compile Remove="Windows\SettingsWindow.xaml.cs" />
    <Compile Remove="Windows\TriggerMessageBox.xaml.cs" />
  </ItemGroup>
  <!-- Exclude old XAML pages (not needed, SDK won't compile .xaml anyway but just to be clean) -->
  <ItemGroup>
    <None Remove="App.xaml" />
    <None Remove="MainWindow.xaml" />
    <None Remove="Themes\generic.xaml" />
    <None Remove="Controls\IntSpinner.xaml" />
    <None Remove="Controls\SetupTreeView.xaml" />
    <None Remove="Controls\Terraria\TerrariaScrollBar.xaml" />
    <None Remove="Controls\Terraria\TerrariaSetupEntry.xaml" />
    <None Remove="Controls\Terraria\TerrariaSetupFolder.xaml" />
    <None Remove="Controls\Terraria\TerrariaSetupList.xaml" />
    <None Remove="Controls\Terraria\TerrariaSetupOptionButton.xaml" />
    <None Remove="Controls\Terraria\TerrariaStyles.xaml" />
    <None Remove="Controls\Terraria\TerrariaTooltip.xaml" />
    <None Remove="Windows\AboutWindow.xaml" />
    <None Remove="Windows\CreditsWindow.xaml" />
    <None Remove="Windows\EditFolderWindow.xaml" />
    <None Remove="Windows\EditGameWindow.xaml" />
    <None Remove="Windows\EditServerWindow.xaml" />
    <None Remove="Windows\EditToolWindow.xaml" />
    <None Remove="Windows\ErrorMessageBox.xaml" />
    <None Remove="Windows\SettingsWindow.xaml" />
    <None Remove="Windows\TriggerMessageBox.xaml" />
  </ItemGroup>

  <!-- ── macOS .app bundle (run after dotnet publish -r osx-*) ────────── -->
  <Target Name="CreateMacBundle" AfterTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <PropertyGroup>
      <_BundleRoot>$(PublishDir)..\TerraLauncher.app</_BundleRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(_BundleRoot)" />
    <MakeDir   Directories="$(_BundleRoot)/Contents/MacOS" />
    <MakeDir   Directories="$(_BundleRoot)/Contents/Resources" />
    <Exec Command="cp -r &quot;$(PublishDir).&quot; &quot;$(_BundleRoot)/Contents/MacOS/&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/macOS/Info.plist"
          DestinationFiles="$(_BundleRoot)/Contents/Info.plist" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/macOS/TerraLauncher.icns"
          DestinationFiles="$(_BundleRoot)/Contents/Resources/TerraLauncher.icns" />
    <Exec Command="chmod +x &quot;$(_BundleRoot)/Contents/MacOS/TerraLauncher&quot;" />
    <Message Text="&#x2713; macOS bundle: $(_BundleRoot)" Importance="High" />
  </Target>

  <!-- ── Linux: icon + .desktop + install script ───────────────────────── -->
  <Target Name="CopyLinuxAssets" AfterTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/linux/TerraLauncher.png"
          DestinationFiles="$(PublishDir)TerraLauncher.png" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/linux/TerraLauncher.desktop"
          DestinationFiles="$(PublishDir)TerraLauncher.desktop" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/linux/install-linux.sh"
          DestinationFiles="$(PublishDir)install-linux.sh" />
    <Exec Command="chmod +x &quot;$(PublishDir)TerraLauncher&quot; &quot;$(PublishDir)install-linux.sh&quot;" />
    <Message Text="&#x2713; Linux assets copied to $(PublishDir)" Importance="High" />
  </Target>
</Project>
