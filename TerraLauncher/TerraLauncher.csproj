<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TerraLauncher</RootNamespace>
    <AssemblyName>TerraLauncher</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- CA1416: the analyzer doesn't infer "Windows-only" from the -windows TFM suffix
         for WinForms/GDI+ APIs used by the legacy IconPack/FolderBrowserLauncher code;
         this app only ever targets Windows, so the warning is a false positive.
         NU1510: ConfigurationManager looks "unreferenced" to package pruning even
         though Settings.Designer.cs uses ApplicationSettingsBase directly. -->
    <NoWarn>$(NoWarn);CA1416;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <DependentUpon>Settings.settings</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>

  <!-- Images/icons/font referenced via pack URIs (e.g. "Resources/Icons/AppError.ico")
       must be Build Action "Resource" — SDK-style default globs don't set this. -->
  <ItemGroup>
    <Resource Include="App.ico" />
    <Resource Include="Resources\**\*.png" />
    <Resource Include="Resources\**\*.ico" />
    <Resource Include="Resources\**\*.ttf" />
  </ItemGroup>

  <!-- Bundled version-list data for the instance downloader, loaded via
       Assembly.GetManifestResourceStream (not a WPF pack resource). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\VersionData\*.json" />
  </ItemGroup>

</Project>
