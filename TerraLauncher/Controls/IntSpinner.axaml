<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TerraLauncher.Controls.IntSpinner"
             x:Name="Root"
             Height="22" Width="80"
             HorizontalAlignment="Left" VerticalAlignment="Top">
  <Grid ColumnDefinitions="*,20">
    <TextBox x:Name="textBox"
             Grid.Column="0"
             Text="0"
             TextAlignment="Right"
             VerticalContentAlignment="Center"
             Padding="2,0"
             BorderThickness="1"
             CornerRadius="2,0,0,2"
             TextChanged="OnTextChanged"
             LostFocus="OnFocusLost"/>
    <StackPanel Grid.Column="1" Spacing="0">
      <RepeatButton x:Name="btnUp" Height="11"
                    Click="OnIncrease"
                    Padding="0" FontSize="8"
                    CornerRadius="0,2,0,0"
                    Content="▲"/>
      <RepeatButton x:Name="btnDown" Height="11"
                    Click="OnDecrease"
                    Padding="0" FontSize="8"
                    CornerRadius="0,0,2,0"
                    Content="▼"/>
    </StackPanel>
  </Grid>
</UserControl>
