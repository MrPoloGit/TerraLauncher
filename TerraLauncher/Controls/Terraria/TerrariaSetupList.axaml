<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:terraria="clr-namespace:TerraLauncher.Controls.Terraria"
             x:Class="TerraLauncher.Controls.Terraria.TerrariaSetupList">
  <terraria:TerrariaScrollBox x:Name="scrollBox" Margin="6">
    <StackPanel x:Name="list"/>
  </terraria:TerrariaScrollBox>
</UserControl>
