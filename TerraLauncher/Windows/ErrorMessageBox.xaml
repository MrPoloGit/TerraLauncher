<Window x:Class="TerraLauncher.Windows.ErrorMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        Background="{x:Null}" AllowsTransparency="True" WindowStyle="None" WindowStartupLocation="CenterScreen" Title="Unhandled Exception" Icon="/Resources/Icons/AppError.ico" SnapsToDevicePixels="True" UseLayoutRounding="True" SizeToContent="WidthAndHeight" PreviewKeyDown="OnPreviewKeyDown" Closing="OnWindowClosing" FontFamily="/TerraLauncher;component/Resources/#Andy">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <controls:TerrariaWindow CanMinimize="False" CanResize="False">
    <Grid x:Name="clientArea" Width="504" Height="230" Margin="0,44,0,0">
        <Label Margin="18,15,18,0" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0">
            <TextBlock  TextWrapping="WrapWithOverflow" Text="Unhandled Exception in Terra Launcher!" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FFFF6B6B" FontWeight="Bold"/>
        </Label>
        <Label HorizontalAlignment="Right" Margin="0,10,18,0" VerticalAlignment="Top" FontWeight="Bold">
            <Hyperlink NavigateUri="https://github.com/trigger-death/TerraLauncher" RequestNavigate="OnRequestNavigate" Focusable="False">
                <Run Text="Github Page"/>
            </Hyperlink>
        </Label>

        <Border Margin="18,43,18,54" BorderThickness="1" BorderBrush="#FF14143A" Grid.ColumnSpan="2">
            <ScrollViewer x:Name="scrollViewer" Background="#FF1E1E5A" Padding="4,1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="textBlockMessage" Text="Exception:" HorizontalAlignment="Left" VerticalAlignment="Top" SizeChanged="OnMessageSizeChanged"/>
            </ScrollViewer>
        </Border>

        <Rectangle Fill="#FF14143A" Height="49" Margin="0" VerticalAlignment="Bottom" StrokeThickness="0"/>
        <Separator Background="#FF6675CC" Margin="0,0,0,48" VerticalAlignment="Bottom"/>
        
        <Button x:Name="buttonException" Content="See Full Exception" HorizontalAlignment="Left" Margin="18,0,0,12" VerticalAlignment="Bottom" Width="128" Click="OnSeeFullException"/>
        <Button x:Name="buttonCopy" Content="Copy to Clipboard" HorizontalAlignment="Left" Margin="151,0,0,12" VerticalAlignment="Bottom" Width="128" Click="OnCopyToClipboard"/>
        <StackPanel Margin="0,0,18,12" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="buttonContinue" Content="Continue" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Bottom" Width="80" IsCancel="True"/>
            <Button x:Name="buttonExit" Content="Exit" HorizontalAlignment="Right" Margin="5,0,0,0" VerticalAlignment="Bottom" Width="80" Click="OnExit" IsDefault="True"/>
        </StackPanel>
    </Grid>
    </controls:TerrariaWindow>
</Window>
