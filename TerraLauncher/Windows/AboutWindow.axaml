<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        x:Class="TerraLauncher.Windows.AboutWindow"
        Title="About Terra Launcher"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="avares://TerraLauncher/Resources/Andy.ttf#Andy"
        Opacity="0">

  <controls:TerrariaWindow>
    <Border Margin="8,40,8,10" Background="#323381" BorderThickness="2" BorderBrush="#14143A"
            Padding="16,14,16,14">
      <StackPanel Spacing="12">

        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="avares://TerraLauncher/Resources/Icons/AppIcon.png" Width="80" Height="80"
                 VerticalAlignment="Top"/>
          <StackPanel Spacing="2">
            <TextBlock Text="Terra Launcher" FontSize="24" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Version:" FontSize="16" Foreground="#AAAACC"/>
              <TextBlock x:Name="labelVersion" FontSize="16" Foreground="White"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Build Date:" FontSize="16" Foreground="#AAAACC"/>
              <TextBlock x:Name="labelBuildDate" FontSize="16" Foreground="White"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Original By:" FontSize="16" Foreground="#AAAACC"/>
              <TextBlock Text="trigger_death (Robert Jordan)" FontSize="16" Foreground="White"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Ported By:" FontSize="16" Foreground="#AAAACC"/>
              <TextBlock Text="MrPolo" FontSize="16" Foreground="White"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border Height="2" Background="#14143A"/>

        <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="White"
                   Text="Terra Launcher is a hub for everything Terraria-related stored on your computer — game versions, mod loaders, servers, and tools. This is a cross-platform port of the original Terra Launcher for Windows."/>

        <controls:TerrariaButton HorizontalAlignment="Right" Click="OnClose">
          <TextBlock Text="Close" Foreground="White" FontSize="18" Margin="14,3"/>
        </controls:TerrariaButton>

      </StackPanel>
    </Border>
  </controls:TerrariaWindow>
</Window>
