<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        x:Class="TerraLauncher.Windows.AboutWindow"
        Title="About Terra Launcher"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="avares://TerraLauncher/Resources/Andy.ttf#Andy"
        Opacity="0">

  <controls:TerrariaWindow>
    <Border Margin="8,40,8,10" Background="#323381" BorderThickness="2" BorderBrush="#14143A"
            Padding="16,14,16,14">
      <StackPanel Spacing="12">

        <!-- Grids, not horizontal StackPanels — those measure with infinite
             width and defeat text wrapping -->
        <Grid ColumnDefinitions="Auto,*">
          <Image Grid.Column="0" Source="avares://TerraLauncher/Resources/Icons/AppIcon.png"
                 Width="80" Height="80" VerticalAlignment="Top" Margin="0,0,14,0"/>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Terra Launcher" FontSize="24" Foreground="White" Margin="0,0,0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" FontSize="16" Foreground="#AAAACC" Margin="0,0,6,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="labelVersion" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Build Date:" FontSize="16" Foreground="#AAAACC" Margin="0,0,6,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="labelBuildDate" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Original By:" FontSize="16" Foreground="#AAAACC" Margin="0,0,6,2"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="trigger_death (Robert Jordan)" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ported By:" FontSize="16" Foreground="#AAAACC" Margin="0,0,6,2"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="MrPolo" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
          </Grid>
        </Grid>

        <Border Height="2" Background="#14143A"/>

        <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="White"
                   Text="Terra Launcher is a hub for everything Terraria-related stored on your computer — game versions, mod loaders, servers, and tools. This is a cross-platform port of the original Terra Launcher for Windows."/>

        <controls:TerrariaButton HorizontalAlignment="Right" Click="OnClose">
          <TextBlock Text="Close" Foreground="White" FontSize="18" Margin="14,3"/>
        </controls:TerrariaButton>

      </StackPanel>
    </Border>
  </controls:TerrariaWindow>
</Window>
