<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        x:Class="TerraLauncher.Windows.TriggerMessageBox"
        Title="Message"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Width="380"
        SizeToContent="Height"
        MinWidth="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="avares://TerraLauncher/Resources/Andy.ttf#Andy"
        Opacity="0">

  <controls:TerrariaWindow>
    <Border Margin="8,40,8,10" Background="#323381" BorderThickness="2" BorderBrush="#14143A"
            Padding="16,14,16,14">
      <StackPanel Spacing="16">

        <!-- Icon + Message (Grid, not horizontal StackPanel — the latter
             measures with infinite width and defeats text wrapping) -->
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock x:Name="textBlockIcon" Grid.Column="0"
                     Text="⚠"
                     FontSize="26"
                     VerticalAlignment="Top"
                     Margin="0,2,14,0"/>
          <TextBlock x:Name="textBlockMessage" Grid.Column="1"
                     Text="Message"
                     TextWrapping="Wrap"
                     Foreground="White"
                     FontSize="17"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel x:Name="stackPanelButtons"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
          <controls:TerrariaButton x:Name="button1" Click="OnButtonClicked">
            <TextBlock x:Name="label1" Text="Yes" Foreground="White" FontSize="18" Margin="14,3"/>
          </controls:TerrariaButton>
          <controls:TerrariaButton x:Name="button2" Click="OnButtonClicked">
            <TextBlock x:Name="label2" Text="No" Foreground="White" FontSize="18" Margin="14,3"/>
          </controls:TerrariaButton>
          <controls:TerrariaButton x:Name="button3" Click="OnButtonClicked">
            <TextBlock x:Name="label3" Text="Cancel" Foreground="White" FontSize="18" Margin="14,3"/>
          </controls:TerrariaButton>
        </StackPanel>

      </StackPanel>
    </Border>
  </controls:TerrariaWindow>
</Window>
