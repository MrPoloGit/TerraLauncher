<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        xmlns:local="clr-namespace:TerraLauncher.Controls"
        x:Class="TerraLauncher.Windows.SettingsWindow"
        Title="Settings"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Width="400" Height="460"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="avares://TerraLauncher/Resources/Andy.ttf#Andy"
        Opacity="0">

  <controls:TerrariaWindow>
    <Grid>

      <!-- Settings content -->
      <Border Margin="8,40,8,50" Background="#323381" BorderThickness="2" BorderBrush="#14143A">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="14,12,14,12">

            <TextBlock Text="Terraria Installation" FontSize="22" Foreground="White" Margin="0,0,0,4"/>
            <TextBlock Text="Executable path (leave blank to auto-detect from Steam)" FontSize="11" Opacity="0.6" Foreground="White"/>
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBox x:Name="textBoxTerrariaPath"
                       Grid.Column="0"
                       Watermark="Auto-detect from Steam"
                       Background="#14143A" Foreground="White"
                       BorderBrush="#4A4AAA" BorderThickness="1"
                       CornerRadius="3,0,0,3"
                       Padding="6,4"
                       CaretBrush="White"/>
              <controls:TerrariaButton Grid.Column="1" Click="OnBrowseTerrariaPath"
                                       Padding="0" Width="36">
                <TextBlock Text="..." Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </controls:TerrariaButton>
            </Grid>

            <Border Height="2" Background="#14143A" Margin="0,10,0,2"/>

            <TextBlock Text="Launch Behavior" FontSize="22" Foreground="White" Margin="0,0,0,2"/>
            <CheckBox x:Name="checkBoxCloseGame"   Content="Close when launching Games"   Foreground="White"/>
            <CheckBox x:Name="checkBoxCloseServer" Content="Close when launching Servers" Foreground="White"/>
            <CheckBox x:Name="checkBoxCloseTool"   Content="Close when launching Tools"   Foreground="White"/>
            <TextBlock Text="Hold Shift while launching to keep open" FontSize="11" Opacity="0.6" Foreground="White"/>
            <TextBlock Text="Hold Ctrl while launching to close"      FontSize="11" Opacity="0.6" Foreground="White"/>

            <Border Height="2" Background="#14143A" Margin="0,6,0,2"/>

            <TextBlock Text="Display" FontSize="22" Foreground="White" Margin="0,0,0,2"/>
            <CheckBox x:Name="checkBoxDisableTransitions" Content="Disable Transitions" Foreground="White"/>
            <CheckBox x:Name="checkBoxMuted"              Content="Mute Menu Sounds"    Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
              <TextBlock Text="Scroll Speed" VerticalAlignment="Center" Foreground="White"/>
              <local:IntSpinner x:Name="spinnerScrollSpeed" Maximum="300" Minimum="10"/>
            </StackPanel>

            <Border Height="2" Background="#14143A" Margin="0,6,0,2"/>

            <TextBlock Text="Integration" FontSize="22" Foreground="White" Margin="0,0,0,2"/>
            <CheckBox x:Name="checkBoxIntegration" Content="Integrate with Other Trigger Tools" Foreground="White"/>

            <Border Height="2" Background="#14143A" Margin="0,6,0,2"/>

            <TextBlock Text="Help" FontSize="22" Foreground="White" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:TerrariaButton Click="OnAbout">
                <TextBlock Text="About"   Foreground="White" FontSize="18" Margin="10,3"/>
              </controls:TerrariaButton>
              <controls:TerrariaButton Click="OnCredits">
                <TextBlock Text="Credits" Foreground="White" FontSize="18" Margin="10,3"/>
              </controls:TerrariaButton>
              <controls:TerrariaButton Click="OnViewOnGitHub">
                <TextBlock Text="GitHub"  Foreground="White" FontSize="18" Margin="10,3"/>
              </controls:TerrariaButton>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Save button -->
      <controls:TerrariaButton HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,8,8" Click="OnSaveClicked">
        <TextBlock Text="Save" Foreground="White" FontSize="22" Margin="12,3"/>
      </controls:TerrariaButton>

    </Grid>
  </controls:TerrariaWindow>
</Window>
