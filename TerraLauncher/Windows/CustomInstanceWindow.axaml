<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        x:Class="TerraLauncher.Windows.CustomInstanceWindow"
        Title="Add Custom Instance"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="avares://TerraLauncher/Resources/Andy.ttf#Andy"
        Opacity="0">

  <controls:TerrariaWindow>
    <Border Margin="8,40,8,10" Background="#323381" BorderThickness="2" BorderBrush="#14143A"
            Padding="16,14,16,14">
      <StackPanel Spacing="10">

        <TextBlock Text="Link an executable, app, or script to launch."
                   TextWrapping="Wrap" FontSize="16" Foreground="White"/>

        <StackPanel Spacing="4">
          <TextBlock Text="Name" Foreground="White" FontSize="15" Opacity="0.8"/>
          <TextBox x:Name="textBoxName" FontSize="15" Watermark="My Instance"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Executable" Foreground="White" FontSize="15" Opacity="0.8"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="textBoxPath" Grid.Column="0" FontSize="15"
                     Watermark="Path to launch"/>
            <controls:TerrariaButton Grid.Column="1" Click="OnBrowse" Padding="0" Width="36">
              <TextBlock Text="..." Foreground="White" FontSize="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </controls:TerrariaButton>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Category" Foreground="White" FontSize="15" Opacity="0.8"/>
          <ComboBox x:Name="comboCategory" FontSize="15" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <controls:TerrariaButton Click="OnAdd">
            <TextBlock Text="Add" Foreground="White" FontSize="18" Margin="14,3"/>
          </controls:TerrariaButton>
          <controls:TerrariaButton Click="OnCancel">
            <TextBlock Text="Cancel" Foreground="White" FontSize="18" Margin="14,3"/>
          </controls:TerrariaButton>
        </StackPanel>

      </StackPanel>
    </Border>
  </controls:TerrariaWindow>
</Window>
