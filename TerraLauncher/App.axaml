<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TerraLauncher.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TerraLauncher/Themes/generic.axaml"/>
        <StyleInclude Source="avares://TerraLauncher/Controls/Terraria/TerrariaScrollBar.axaml"/>
        <StyleInclude Source="avares://TerraLauncher/Controls/Terraria/TerrariaStyles.axaml"/>
    </Application.Styles>
</Application>
