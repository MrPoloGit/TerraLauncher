<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TerraLauncher.Controls.Terraria"
        x:Class="TerraLauncher.MainWindow"
        Title="Terra Launcher"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Height="460" Width="600"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="avares://TerraLauncher/Resources/Andy.ttf#Andy"
        Icon="avares://TerraLauncher/Resources/Icons/AppIcon.png"
        Opacity="0">

  <Window.Styles>
    <!-- Terraria-themed search box: dark panel, gold accent, no Fluent
         white-on-focus background swap or blue focus ring -->
    <Style Selector="TextBox.terraria">
      <Setter Property="Background" Value="#14143A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1E1E50"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CaretBrush" Value="#C8A852"/>
      <Setter Property="SelectionBrush" Value="#C8A852"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBox.terraria /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#8888AA"/>
    </Style>
    <Style Selector="TextBox.terraria:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#14143A"/>
      <Setter Property="BorderBrush" Value="#4A4AAA"/>
    </Style>
    <Style Selector="TextBox.terraria:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#14143A"/>
      <Setter Property="BorderBrush" Value="#C8A852"/>
    </Style>
    <Style Selector="TextBox.terraria:pointerover">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="TextBox.terraria:focus">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Terraria-themed filter dropdown -->
    <Style Selector="ComboBox.terraria">
      <Setter Property="Background" Value="#14143A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1E1E50"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ComboBox.terraria:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#14143A"/>
      <Setter Property="BorderBrush" Value="#4A4AAA"/>
    </Style>
    <Style Selector="ComboBox.terraria:focus /template/ Border#Background">
      <Setter Property="Background" Value="#14143A"/>
      <Setter Property="BorderBrush" Value="#C8A852"/>
    </Style>
    <Style Selector="ComboBox.terraria /template/ Path#DropDownGlyph">
      <Setter Property="Fill" Value="#C8A852"/>
    </Style>
    <Style Selector="ComboBox.terraria /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="#C8A852"/>
    </Style>
  </Window.Styles>
  <controls:TerrariaWindow>
    <Grid>
      <!-- Main content area -->
      <Border Margin="8,40,8,49" Background="#323381" BorderThickness="2" BorderBrush="#14143A"
              ClipToBounds="True">
        <Grid x:Name="gridGames"/>
      </Border>

      <!-- Search + instance filter (bottom left) -->
      <TextBox x:Name="textBoxSearch" Classes="terraria"
               Watermark="Search…"
               Width="160" Height="32"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,7"
               CornerRadius="10" Padding="10,5"
               FontSize="14"
               TextChanged="OnSearchChanged"/>

      <ComboBox x:Name="comboFilter" Classes="terraria"
                Width="130" Height="32"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="176,0,0,7"
                CornerRadius="10" FontSize="14"
                SelectionChanged="OnFilterChanged"/>

      <!-- Open Instances Folder button -->
      <controls:TerrariaButton x:Name="buttonOpenFolder"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,104,0"
                               Click="OnOpenInstancesFolder">
        <ToolTip.Tip><controls:TerrariaTooltip Text="Open Instances Folder"/></ToolTip.Tip>
        <Image Source="avares://TerraLauncher/Resources/Terraria/SetupOptions/SetupOptionHome.png" Width="32" Height="32"/>
      </controls:TerrariaButton>

      <!-- Add Instance button (left of Settings) -->
      <controls:TerrariaButton x:Name="buttonAddInstance"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,56,0"
                               Click="OnAddInstance">
        <ToolTip.Tip><controls:TerrariaTooltip Text="Add Instance"/></ToolTip.Tip>
        <TextBlock Text="+" Foreground="White" FontSize="30" FontWeight="Bold"
                   Width="32" Height="32"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Padding="0,0,0,4"/>
      </controls:TerrariaButton>

      <!-- Settings button (bottom right) -->
      <controls:TerrariaButton x:Name="buttonSettings"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                               Click="OnEditSetups">
        <ToolTip.Tip><controls:TerrariaTooltip Text="Change Settings"/></ToolTip.Tip>
        <Image Source="avares://TerraLauncher/Resources/Terraria/Buttons/SettingsButton.png" Width="32" Height="32"/>
      </controls:TerrariaButton>
    </Grid>
  </controls:TerrariaWindow>
</Window>
